{
    // Worker obsluhuje API i statické soubory z ./web — jeden deploy, žádné CORS.
    // Odchylka od zadání §3 (Pages + Worker zvlášť); důvod v docs/TECHNICAL.md.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hodnoceni-hracu",
    "main": "worker/src/index.ts",
    "compatibility_date": "2026-08-01",

    "assets": {
        "directory": "./web",
        "binding": "ASSETS",
        // Bez tohohle asset server přesměrovává /h.html na /h a z URL zmizí
        // token sebehodnocení. Cesty si proto mapuje Worker sám.
        "html_handling": "none",
        "not_found_handling": "none"
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "hodnoceni-hracu",
            "database_id": "8fe85587-7409-4b95-83f3-d23f340aa2ad"
        }
    ],

    // Cloudflare Email Sending — odkaz na obnovu hesla. Bez SMTP a bez klíčů.
    // Doména odesílatele (EMAIL_FROM) musí být onboardovaná: Dashboard → Email Service
    // → Email Sending → Onboard Domain (maxferit.cz). Jinak send() vrátí
    // E_SENDER_NOT_VERIFIED; v režimu Email Routing musí být navíc ověřená i adresa
    // příjemce, jinak E_RECIPIENT_NOT_ALLOWED.
    "send_email": [{ "name": "EMAIL" }],

    "vars": {
        "EMAIL_FROM": "hodnoceni@maxferit.cz"
    },

    "observability": { "enabled": true },

    // Aplikace drží osobní údaje nezletilých — čím míň veřejných adres, tím líp.
    // Náhledové URL jednotlivých verzí proto vypnuté, běží jen ostrá adresa.
    "workers_dev": true,
    "preview_urls": false,

    // Secrety (ne proměnné) — `npx wrangler secret put <jméno>`, lokálně .dev.vars:
    //   ADMIN_HESLO    první přihlášení, než se heslo poprvé nastaví z aplikace
    //   SESSION_KEY    podpis session cookie
    //   OBNOVA_EMAILY  čárkami oddělené adresy, kam smí jít odkaz na obnovu hesla
}
