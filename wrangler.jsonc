{
    // Worker obsluhuje API i statické soubory z ./web — jeden deploy, žádné CORS.
    // Odchylka od zadání §3 (Pages + Worker zvlášť); důvod v docs/TECHNICAL.md.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hodnoceni-hracu",
    "main": "worker/src/index.ts",
    "compatibility_date": "2026-08-01",

    "assets": {
        "directory": "./web",
        "binding": "ASSETS",
        // Bez tohohle asset server přesměrovává /h.html na /h a z URL zmizí
        // token sebehodnocení. Cesty si proto mapuje Worker sám.
        "html_handling": "none",
        "not_found_handling": "none"
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "hodnoceni-hracu",
            "database_id": "8fe85587-7409-4b95-83f3-d23f340aa2ad"
        }
    ],

    // Cloudflare Email Sending — odkaz na obnovu hesla. Bez SMTP a bez klíčů.
    // Doména odesílatele (EMAIL_FROM) musí být onboardovaná: Dashboard → Email Service
    // → Email Sending → Onboard Domain (maxferit.cz). Jinak send() vrátí
    // E_SENDER_NOT_VERIFIED; v režimu Email Routing musí být navíc ověřená i adresa
    // příjemce, jinak E_RECIPIENT_NOT_ALLOWED.
    "send_email": [{ "name": "EMAIL" }],

    // Workers AI — jazykový model přímo v účtu, bez klíče a ve free tieru zdarma
    // (denní limit). Slouží příkazovému řádku aplikace. Samotné volání je
    // podmíněné přepínačem v Nastavení, výchozí stav je vypnuto.
    "ai": { "binding": "AI" },

    // Vlastní doména. Zóna maxferit.cz je na stejném účtu, takže si Cloudflare
    // DNS záznam založí sám. workers.dev adresa zůstává funkční jako záloha.
    "routes": [
        { "pattern": "hodnoceni.maxferit.cz", "custom_domain": true }
    ],

    "vars": {
        "EMAIL_FROM": "hodnoceni@maxferit.cz",
        // Používá se v odkazech uvnitř notifikací — ty vznikají v cronu,
        // kde není žádný request, ze kterého by šla adresa odvodit.
        "ZAKLADNI_URL": "https://hodnoceni.maxferit.cz",

        // 'console' = SMS se jen zaloguje a nikam neodejde; 'gosms' = ostré
        // odesílání přes českou bránu (secrety GOSMS_CLIENT_ID, GOSMS_CLIENT_SECRET,
        // GOSMS_KANAL); 'twilio' zůstává jako druhá cesta, ale do Česka končí
        // na chybě 21612 — neregistrovaný odesílatel, viz docs/TECHNICAL.md.
        // Proti protelefonování kreditu hlídá settings.smsDenniStrop.
        "SMS_PROVIDER": "gosms",
        // Kanál v GoSMS, ze kterého se posílá (app.gosms.eu → Kanály → Upravit).
        // Není to tajemství, odesílatele drží GoSMS; secrety jsou jen klíče k API.
        "GOSMS_KANAL": "504031",
        // Alfanumerický odesílatel (max 11 znaků) — používá jen twilio.
        // U GoSMS odesílatele určuje kanál, vlastní jméno je u nich placené.
        "SMS_ODESILATEL": "SKRicmanice"
    },

    // Souhrnné notifikace. Běží každou hodinu, protože Cloudflare umí jen UTC,
    // kdežto čas se nastavuje v aplikaci v místním čase — která hodina je ta
    // správná, rozhodne Worker sám (Europe/Prague).
    //
    // Pozor: Workers Free dovolí 5 cron triggerů na CELÝ účet. Tenhle slot se
    // uvolnil vypnutím denního běhu pojistky-watch (2026-08-06). Další cron
    // na účtu skončí na chybě 10072.
    "triggers": { "crons": ["0 * * * *"] },

    "observability": { "enabled": true },

    // Aplikace drží osobní údaje nezletilých — čím míň veřejných adres, tím líp.
    // Náhledové URL jednotlivých verzí proto vypnuté, běží jen ostrá adresa.
    "workers_dev": true,
    "preview_urls": false,

    // Secrety (ne proměnné) — `npx wrangler secret put <jméno>`, lokálně .dev.vars:
    //   ADMIN_HESLO    první přihlášení, než se heslo poprvé nastaví z aplikace
    //   SESSION_KEY    podpis session cookie
    //   OBNOVA_EMAILY  čárkami oddělené adresy, kam smí jít odkaz na obnovu hesla
}
